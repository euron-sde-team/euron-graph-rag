# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.
name_prefix     = "graphrag-prod"
domain          = "graphrag.example.com"
route53_zone_id = "Z0000000000000000000"
alarm_email     = "oncall@example.com"

# Optional: a hosted model for extraction, community reports and answers, and hosted embeddings,
# instead of the deterministic local providers.
# llm_provider           = "openai"
# llm_model              = "gpt-4.1-mini"
# llm_api_key_secret_arn = "arn:aws:secretsmanager:us-east-1:000000000000:secret:graphrag/llm:LLM_API_KEY::"
# embedding_provider     = "openai"
# embedding_model        = "text-embedding-3-small"
# embedding_dim          = 1536
