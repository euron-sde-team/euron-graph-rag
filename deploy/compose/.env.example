# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
GRAPHRAG_SESSION_SECRET=replace-with-output-of-make-env
GRAPHRAG_API_KEY_PEPPER=replace-with-output-of-make-env
GRAPHRAG_DEMO_PASSWORD=replace-with-output-of-make-env

# Optional: a real model instead of the deterministic local extractor, summarizer and composer
# GRAPHRAG_LLM_PROVIDER=ollama            # or openai: any OpenAI-compatible API
# GRAPHRAG_LLM_MODEL=llama3.2
# GRAPHRAG_OLLAMA_URL=http://host.docker.internal:11434
# GRAPHRAG_LLM_BASE_URL=https://api.openai.com/v1
# GRAPHRAG_LLM_API_KEY=
# GRAPHRAG_EMBEDDING_PROVIDER=ollama      # or openai
# GRAPHRAG_EMBEDDING_MODEL=nomic-embed-text
# GRAPHRAG_EMBEDDING_DIM=768              # 384, 768, 1024 or 1536

# Optional overrides
# GRAPHRAG_PRODUCT_NAME=Euron GraphRAG
# GRAPHRAG_LOG_LEVEL=info
# GRAPHRAG_URL_FETCH_ALLOW_PRIVATE=false
# GRAPHRAG_WEB_PORT=3200
# GRAPHRAG_API_PORT=8200
# GRAPHRAG_PG_PORT=5460
# GRAPHRAG_REDIS_PORT=6420
# GRAPHRAG_FLOCI_PORT=4620
